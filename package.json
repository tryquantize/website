{
  "name": "quantize-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cd packages/web && pnpm dev",
    "build": "cd packages/web && pnpm build",
    "start": "cd packages/web && pnpm start",
    "docker:up": "docker compose -f docker-compose.dev.yml up",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker compose -f docker-compose.dev.yml up --build"
  },
  "workspaces": [
    "packages/*"
  ]
}
